+
+/// The top of Home: a soft violet banner with the app's promise and one clear action.
+fn hero(app: &mut PdfCraftApp, ui: &mut egui::Ui, t: &Tokens) {
+    let dark = t.dark();
+    let width = ui.available_width();
+    let height = 196.0;
+    let (rect, _) = ui.allocate_exact_size(vec2(width, height), Sense::hover());
+    let radius = CornerRadius::same(20);
+    let painter = ui.painter_at(rect);
+    let base = if dark { egui::Color32::from_rgb(0x17, 0x15, 0x26) } else { egui::Color32::from_rgb(0xF4, 0xF1, 0xFF) };
+    painter.rect(rect, radius, base, Stroke::new(1.0, t.border), egui::StrokeKind::Inside);
+    // Two blurred glows, kept clear of the corners so they stay inside the rounding.
+    let glow = |c: egui::Pos2, r: f32, rgb: (u8, u8, u8), alpha: u8| {
+        for i in 0..14u8 {
+            let k = 1.0 - f32::from(i) / 14.0;
+            let a = (f32::from(alpha) * (1.0 - k) * 0.22).round().clamp(0.0, 255.0) as u8;
+            painter.circle_filled(c, r * k, egui::Color32::from_rgba_unmultiplied(rgb.0, rgb.1, rgb.2, a));
+        }
+    };
+    let h = rect.height();
+    glow(egui::pos2(rect.right() - h * 1.1, rect.center().y), h * 0.9, (0x8B, 0x6C, 0xFF), if dark { 120 } else { 90 });
+    glow(egui::pos2(rect.right() - h * 0.45, rect.top() + h * 0.62), h * 0.55, (0x2E, 0xC5, 0xF0), if dark { 70 } else { 55 });
+
+    let left = rect.left() + 32.0;
+    let mut y = rect.top() + 30.0;
+    let chip = tl!("Private · runs in your browser");
+    let chip_font = theme::medium(12.0);
+    let chip_w = ui.fonts_mut(|f| f.layout_no_wrap(chip.to_string(), chip_font.clone(), t.text).size().x) + 34.0;
+    let chip_rect = Rect::from_min_size(egui::pos2(left, y), vec2(chip_w, 24.0));
+    painter.rect_filled(chip_rect, CornerRadius::same(12), t.accent_soft);
+    icons::paint(ui, Rect::from_center_size(egui::pos2(chip_rect.left() + 14.0, chip_rect.center().y), vec2(14.0, 14.0)), "lock", 12.0, t.accent_text);
+    painter.text(egui::pos2(chip_rect.left() + 24.0, chip_rect.center().y), Align2::LEFT_CENTER, chip, chip_font, t.accent_text);
+    y += 38.0;
+    painter.text(egui::pos2(left, y), Align2::LEFT_TOP, tl!("Everything for your PDFs."), theme::semibold(30.0), t.text);
+    y += 44.0;
+    painter.text(
+        egui::pos2(left, y),
+        Align2::LEFT_TOP,
+        tl!("Edit, sign, combine and convert — fast, and your files never leave your device."),
+        theme::regular(14.5),
+        t.text_muted,
+    );
+    y += 34.0;
+
+    let label = tl!("Open a PDF");
+    let font = theme::semibold(14.0);
+    let text_w = ui.fonts_mut(|f| f.layout_no_wrap(label.to_string(), font.clone(), egui::Color32::WHITE).size().x);
+    let button = Rect::from_min_size(egui::pos2(left, y), vec2(text_w + 58.0, 38.0));
+    let resp = ui.interact(button, ui.id().with("hero_open"), Sense::click());
+    resp.widget_info(|| egui::WidgetInfo::labeled(egui::Role::Button, true, label));
+    let fill = if resp.is_pointer_button_down_on() {
+        t.accent.gamma_multiply(0.85)
+    } else if resp.hovered() {
+        t.accent.gamma_multiply(1.12)
+    } else {
+        t.accent
+    };
+    ui.painter().rect_filled(button, CornerRadius::same(19), fill);
+    icons::paint(ui, Rect::from_center_size(egui::pos2(button.left() + 22.0, button.center().y), vec2(16.0, 16.0)), "folder-open", 16.0, egui::Color32::WHITE);
+    ui.painter().text(egui::pos2(button.left() + 38.0, button.center().y), Align2::LEFT_CENTER, label, font, egui::Color32::WHITE);
+    let hint = tl!("or drop a file anywhere");
+    ui.painter().text(egui::pos2(button.right() + 14.0, button.center().y), Align2::LEFT_CENTER, hint, theme::regular(13.0), t.text_faint);
+    if theme::hand(resp).clicked() {
+        app.open_dialog();
+    }
+}

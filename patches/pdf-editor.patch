+
+/// Hand over the two model files (ONNX or RTen) for a host with no model files on disk.
+pub fn provide_models(detection: Vec<u8>, recognition: Vec<u8>) {
+    *PROVIDED.lock().unwrap_or_else(std::sync::PoisonError::into_inner) = Some((detection, recognition));
+    FAILED.store(false, Ordering::Release);
+    PROVIDED_READY.store(true, Ordering::Release);
+}
+
+/// Register how the host fetches the models when recognition is first wanted. The function
+/// starts the fetch and returns; it ends with [`provide_models`] or [`models_failed`].
+pub fn set_model_requester(fetch: fn()) {
+    let _ = REQUESTER.set(fetch);
+}
+
+/// Ask the host for the models if they are missing and it fetches them on demand. Returns
+/// whether a fetch is underway, so the caller can say so and wait.
+pub fn request_models() -> bool {
+    if available() {
+        return false;
+    }
+    let Some(fetch) = REQUESTER.get() else { return false };
+    if !REQUESTED.swap(true, Ordering::AcqRel) {
+        fetch();
+    }
+    !FAILED.load(Ordering::Acquire) && !available()
+}
+
+/// The host's fetch failed. It is not retried until the page is reloaded.
+pub fn models_failed() {
+    FAILED.store(true, Ordering::Release);
+}
+
+/// Whether the last fetch of the models failed.
+pub fn models_fetch_failed() -> bool {
+    FAILED.load(Ordering::Acquire)
 }
 

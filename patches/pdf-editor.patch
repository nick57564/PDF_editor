@@ -532,7 +532,16 @@ pub(super) fn source_program_completes(doc: &Document, fonts: &Dict, line: &Text
 /// A subset may contain all the letters but no space glyph: producers use another subset
 /// or a positioning operator for spaces. Do the same instead of substituting the whole font.
 pub(crate) fn source_encodes(metrics: &Metrics, text: &str) -> bool {
-    text.split(' ').all(|word| metrics.encode(word).is_some())
+    !is_glyphless(&metrics.base_font) && text.split(' ').all(|word| metrics.encode(word).is_some())
+}
+
+/// The outline-free fonts OCR and screenshot-to-PDF tools put under an invisible text layer
+/// (Tesseract's `GlyphLessFont`, often named `Glyphless`). They encode every character, but
+/// draw nothing, or a box, so a rewrite that reuses them shows blanks or black boxes.
+/// Such text is always redrawn in a real font.
+pub(crate) fn is_glyphless(base_font: &str) -> bool {
+    let name = strip_subset_tag(base_font).to_ascii_lowercase();
+    name.starts_with("glyphless")
 }
 

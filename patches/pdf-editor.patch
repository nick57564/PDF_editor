+/// An OCR or screenshot-to-PDF layer drawn in an outline-free font (`Glyphless`, Tesseract's
+/// `GlyphLessFont`) is revealed in a real font: reusing it would show blanks or black boxes.
+#[test]
+fn a_glyphless_ocr_layer_is_redrawn_in_a_real_font() {
+    for base in ["Glyphless", "ABCDEF+GlyphLessFont"] {
+        let mut doc = image_page_with("/Im0 Do BT /F1 20 Tf 3 Tr 42 44 Td (golfen) Tj ET");
+        let page = pdfcraft_model::pages(&doc)[0].obj;
+        let mut res = doc.dict(&Object::Ref(page)).and_then(|p| p.get(b"Resources").and_then(|r| doc.dict(r))).unwrap();
+        let mut font = Dict::new();
+        font.set(b"Type".to_vec(), Object::name("Font"));
+        font.set(b"Subtype".to_vec(), Object::name("Type1"));
+        font.set(b"BaseFont".to_vec(), Object::name(base));
+        font.set(b"Encoding".to_vec(), Object::name("WinAnsiEncoding"));
+        let mut fonts = Dict::new();
+        fonts.set(b"F1".to_vec(), Object::Dict(font));
+        res.set(b"Font".to_vec(), Object::Dict(fonts));
+        doc.update_dict(page, |d| d.set(b"Resources".to_vec(), Object::Dict(res))).unwrap();
+        assert!(text::text_blocks(&doc, 0).unwrap()[0].invisible);
+        text::rewrite_block(&mut doc, 0, 0, Some("golfen en strand"), &text::BlockStyle::default()).unwrap();
+        let doc = reopen(&doc);
+        let ops = pdfcraft_content::parse(&page_content_bytes(&doc, 0)).ops;
+        let fonts = page_fonts(&doc, &pdfcraft_model::pages(&doc)[0]);
+        let shown: Vec<String> = ops
+            .iter()
+            .filter(|o| o.is("Tf"))
+            .filter_map(|o| match o.operands.first() {
+                Some(Object::Name(n)) => fonts.get(n).map(|f| doc.resolve(f)).and_then(|f| f.as_dict().and_then(|d| d.name(b"BaseFont")).map(<[u8]>::to_vec)),
+                _ => None,
+            })
+            .map(|b| String::from_utf8_lossy(&b).into_owned())
+            .collect();
+        assert!(!shown.is_empty(), "{base}: the rewrite sets a font");
+        assert!(shown.iter().all(|b| !b.to_ascii_lowercase().contains("glyphless")), "{base}: drawn in a real font, not {shown:?}");
+    }
+}

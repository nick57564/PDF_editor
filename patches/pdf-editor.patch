+
+/// The outline-free fonts OCR and screenshot-to-PDF tools put under an invisible text layer
+/// (Tesseract's `GlyphLessFont`, often named `Glyphless`). They encode every character, but
+/// draw nothing, or a box, so a rewrite that reuses them shows blanks or black boxes.
+/// Such text is always redrawn in a real font.
+pub(crate) fn is_glyphless(base_font: &str) -> bool {
+    let name = strip_subset_tag(base_font).to_ascii_lowercase();
+    name.starts_with("glyphless")
 }
 
